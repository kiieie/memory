# 전체 목록 근거: docs/reference/infra-ops.md#환경변수
# 로컬 개발: 아래 기본값 그대로 써도 docker compose up까지는 됨 (DB/Redis는 컨테이너 내부 접속).
# OCI_*, ALIMTALK_*, KAKAO_*, AI_* 는 실제 값 없으면 readyz의 storage 체크만 degraded로 나온다.

# --- core ---
DATABASE_URL=postgresql+asyncpg://lastletter:lastletter@postgres:5432/lastletter
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=lastletter
POSTGRES_PASSWORD=lastletter
POSTGRES_DB=lastletter

# --- auth ---
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- object storage (OCI, S3 호환) ---
OCI_NAMESPACE=
OCI_BUCKET=
OCI_REGION=
OCI_S3_ENDPOINT=
OCI_ACCESS_KEY=
OCI_SECRET_KEY=
OCI_VAULT_KEY_OCID=

# --- messaging ---
ALIMTALK_API_KEY=
ALIMTALK_SENDER_KEY=
SMS_API_KEY=

# --- kakao oauth ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost/api/v1/auth/kakao/callback

# --- auth cookie ---
# 로컬 http 테스트 시 false. 프로덕션(https)은 true 유지.
COOKIE_SECURE=true

# --- AI (GPU 서버, OpenAI 호환) ---
AI_BASE_URL=http://localhost:8001/v1
AI_API_KEY=
AI_MODEL_CHAT=qwen2.5-32b-instruct
AI_MODEL_ASR=whisper-large-v3
AI_TIMEOUT_SEC=60

# --- ops ---
ADMIN_ALERT_WEBHOOK=

# --- caddy / frontend ---
# 로컬: :80 (기본값, TLS 없음). 프로덕션: memory.2convert.org (자동 TLS)
SITE_ADDRESS=:80
NEXT_PUBLIC_API_BASE=/api/v1
